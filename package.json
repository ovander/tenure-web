{
  "name": "tenure-web",
  "version": "0.32.0",
  "private": true,
  "type": "module",
  "description": "Tenure web app (RENT-FE-001), embedded by tenure-api",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/budget.mjs",
    "preview": "node scripts/serve.mjs",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json && vue-tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint --max-warnings 0 .",
    "test": "vitest run",
    "e2e": "playwright test",
    "api": "node scripts/gen-api.mjs",
    "api:check": "node scripts/gen-api.mjs --check"
  },
  "dependencies": {
    "@primeuix/themes": "1.2.5",
    "pinia": "2.3.1",
    "primeicons": "7.0.0",
    "primevue": "4.4.1",
    "vue": "3.5.44",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.5",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/test-utils": "2.5.1",
    "eslint": "10.14.0",
    "eslint-plugin-vue": "10.12.0",
    "jsdom": "30.1.3",
    "openapi-typescript": "7.13.0",
    "swagger2openapi": "7.0.8",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.5",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "3.3.14"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    },
    "minimatch@>=7 <11.0.1": "11.0.4",
    "glob": "14.0.3"
  }
}
